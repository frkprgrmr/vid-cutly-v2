# Dapatkan key dari Google AI Studio. Jangan commit file .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# OAuth 2.0 Web application dari Google Cloud Console.
# Akun Google Cloud boleh berbeda dari akun pemilik channel YouTube.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://127.0.0.1:8000/api/youtube/callback

# Opsional
APP_DATA_DIR=./data
APP_HOST=127.0.0.1
APP_PORT=8000
VIDEO_MAX_HEIGHT=1080

# Speaker/face tracking. Nilai default memprioritaskan akurasi dibanding switch cepat.
REFRAME_SPEAKER_WINDOW_SECONDS=1.2
REFRAME_SPEAKER_MIN_CONFIDENCE=0.10
REFRAME_SPEAKER_SWITCH_MARGIN=0.08
REFRAME_SPEAKER_MIN_STABLE_SECONDS=0.8
REFRAME_TRACK_MAX_MISSING_SECONDS=1.2
REFRAME_AUDIO_GATE_ENABLED=true
REFRAME_TRACKING_DEBUG=false
