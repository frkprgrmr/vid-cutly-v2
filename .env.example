# Dapatkan key dari Google AI Studio. Jangan commit file .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# OAuth 2.0 Web application dari Google Cloud Console.
# Akun Google Cloud boleh berbeda dari akun pemilik channel YouTube.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://127.0.0.1:8000/api/youtube/callback

# Opsional
APP_DATA_DIR=./data
APP_HOST=127.0.0.1
APP_PORT=8000
VIDEO_MAX_HEIGHT=1080
